# Local OpenJev is the default. No API key or paid fallback.
JEV_PROVIDER=openjev
OPENJEV_URL=http://127.0.0.1:8767
# npm start opens a Minecraft window and follows the agent. Set false for terminal only.
JEV_VIEWER=true
# Optional paid provider only when explicitly selecting JEV_PROVIDER=typesafe.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Jev
# Use microsoft for an authenticated Minecraft account; offline only on a server permitting it.
MC_AUTH=offline
# Leave blank for protocol negotiation. Must be supported by the installed Mineflayer version.
MC_VERSION=
JEV_DB=data/experience.sqlite
# Explicit label for this world; different worlds must have different labels.
JEV_WORLD=local-world-1
JEV_STEPS=300
# adaptive: learn; baseline: Jev only; evaluate: use learned values without updating them.
JEV_MODE=adaptive
